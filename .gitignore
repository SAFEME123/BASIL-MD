auth_info_baileys/

# SQLite databases (runtime data)
data/*.db
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm

# Dashboard credentials (contains the dashboard password)
data/dashboard.json

# Per-user GitHub tokens
data/github_tokens.json

# Per-user site login cookies
data/site_cookies.json

# In-memory store snapshots
store.json
*.store.json

# Temp / downloads
temp/
tmp/
downloads/

# Runtime plugin availability / unavailable lists
data/unavailable-plugins.json

# ===== Logs =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pm2.log
*.pid

# ===== Editor / OS =====
.DS_Store
Thumbs.db
.idea/
*.swp
*~

# Keep .vscode/ minimal (share launch configs if desired, ignore user state)
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json

# ===== Build / Coverage =====
dist/
build/
coverage/
.nyc_output/

